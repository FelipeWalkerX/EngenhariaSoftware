#Requisito 1: Cadastro com validação de entrada
import hashlib

def gerar_hash(senha):
    return hashlib.sha256(senha.encode("utf-8")).hexdigest()


def validar_senha(senha):
    if len(senha) < 6:
        return False, "senha muito curta (minimo 6 caracteres)"

    tem_numero = False
    for letra in senha:
        if letra.isdigit():
            tem_numero = True

    if not tem_numero:
        return False, "senha precisa ter pelo menos 1 numero"

    return True, "senha ok"


def cadastrar_usuario(usuarios, nome, senha):
    nome = nome.strip()

    if nome == "":
        return False, "nome vazio"

    if nome in usuarios:
        return False, "usuario ja existe"

    ok, mensagem = validar_senha(senha)
    if not ok:
        return False, mensagem

    usuarios[nome] = gerar_hash(senha)
    return True, "usuario cadastrado"